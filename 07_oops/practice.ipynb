    "# class\n",
    "class Car:\n",
    "    def __init__(self, brand, model):\n",
    "        self.brand = brand\n",
    "        self.model = model\n",
    "    \n",
    "    def drive(self):\n",
    "        return f\"Your Car is {self.model} of {self.brand}\""
   ]
